<?xml version="1.0"?>
<sdf version="1.9">
  <world name="rb3302_course">
    <physics name="physics" type="ode">
      <max_step_size>0.002</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <gravity>0 0 -9.81</gravity>
    <scene>
      <ambient>0.55 0.55 0.55 1</ambient>
      <background>0.75 0.80 0.86 1</background>
      <shadows>true</shadows>
    </scene>

    <light name="sun" type="directional">
      <cast_shadows>true</cast_shadows>
      <pose>1.8 1.2 8 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.4 0.2 -0.9</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <pose>1.8 1.2 -0.005 0 0 0</pose>
      <link name="ground">
        <collision name="collision">
          <geometry><box><size>5.0 3.8 0.01</size></box></geometry>
          <surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface>
        </collision>
        <visual name="visual">
          <geometry><box><size>5.0 3.8 0.01</size></box></geometry>
          <material>
            <ambient>0.88 0.88 0.86 1</ambient>
            <diffuse>0.88 0.88 0.86 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- All wall poses use the map frame convention: +x east, +y north. -->
    <model name="course_walls">
      <static>true</static>
      <link name="walls">
        <!-- Outer boundary. -->
        <collision name="south_collision"><pose>1.8 0 0.15 0 0 0</pose><geometry><box><size>3.64 0.04 0.30</size></box></geometry></collision>
        <visual name="south_visual"><pose>1.8 0 0.15 0 0 0</pose><geometry><box><size>3.64 0.04 0.30</size></box></geometry><material><ambient>0.75 0.77 0.80 1</ambient><diffuse>0.75 0.77 0.80 1</diffuse></material></visual>
        <collision name="north_collision"><pose>1.8 2.4 0.15 0 0 0</pose><geometry><box><size>3.64 0.04 0.30</size></box></geometry></collision>
        <visual name="north_visual"><pose>1.8 2.4 0.15 0 0 0</pose><geometry><box><size>3.64 0.04 0.30</size></box></geometry><material><ambient>0.75 0.77 0.80 1</ambient><diffuse>0.75 0.77 0.80 1</diffuse></material></visual>
        <collision name="west_collision"><pose>0 1.2 0.15 0 0 0</pose><geometry><box><size>0.04 2.4 0.30</size></box></geometry></collision>
        <visual name="west_visual"><pose>0 1.2 0.15 0 0 0</pose><geometry><box><size>0.04 2.4 0.30</size></box></geometry><material><ambient>0.75 0.77 0.80 1</ambient><diffuse>0.75 0.77 0.80 1</diffuse></material></visual>
        <collision name="east_collision"><pose>3.6 1.2 0.15 0 0 0</pose><geometry><box><size>0.04 2.4 0.30</size></box></geometry></collision>
        <visual name="east_visual"><pose>3.6 1.2 0.15 0 0 0</pose><geometry><box><size>0.04 2.4 0.30</size></box></geometry><material><ambient>0.75 0.77 0.80 1</ambient><diffuse>0.75 0.77 0.80 1</diffuse></material></visual>

        <!-- Internal segments, each aligned to the 0.60 m grid. -->
        <collision name="h_w_collision"><pose>0.6 1.5 0.15 0 0 0</pose><geometry><box><size>0.04 0.6 0.30</size></box></geometry></collision>
        <visual name="h_w_visual"><pose>0.6 1.5 0.15 0 0 0</pose><geometry><box><size>0.04 0.6 0.30</size></box></geometry><material><ambient>0.75 0.77 0.80 1</ambient><diffuse>0.75 0.77 0.80 1</diffuse></material></visual>
        <collision name="h_n_collision"><pose>0.9 1.8 0.15 0 0 0</pose><geometry><box><size>0.6 0.04 0.30</size></box></geometry></collision>
        <visual name="h_n_visual"><pose>0.9 1.8 0.15 0 0 0</pose><geometry><box><size>0.6 0.04 0.30</size></box></geometry><material><ambient>0.75 0.77 0.80 1</ambient><diffuse>0.75 0.77 0.80 1</diffuse></material></visual>
        <collision name="h_s_collision"><pose>0.9 1.2 0.15 0 0 0</pose><geometry><box><size>0.6 0.04 0.30</size></box></geometry></collision>
        <visual name="h_s_visual"><pose>0.9 1.2 0.15 0 0 0</pose><geometry><box><size>0.6 0.04 0.30</size></box></geometry><material><ambient>0.75 0.77 0.80 1</ambient><diffuse>0.75 0.77 0.80 1</diffuse></material></visual>
        <collision name="n_e_collision"><pose>1.2 0.9 0.15 0 0 0</pose><geometry><box><size>0.04 0.6 0.30</size></box></geometry></collision>
        <visual name="n_e_visual"><pose>1.2 0.9 0.15 0 0 0</pose><geometry><box><size>0.04 0.6 0.30</size></box></geometry><material><ambient>0.75 0.77 0.80 1</ambient><diffuse>0.75 0.77 0.80 1</diffuse></material></visual>
        <collision name="n_s_collision"><pose>0.9 0.6 0.15 0 0 0</pose><geometry><box><size>0.6 0.04 0.30</size></box></geometry></collision>
        <visual name="n_s_visual"><pose>0.9 0.6 0.15 0 0 0</pose><geometry><box><size>0.6 0.04 0.30</size></box></geometry><material><ambient>0.75 0.77 0.80 1</ambient><diffuse>0.75 0.77 0.80 1</diffuse></material></visual>

        <collision name="j_w_collision"><pose>1.8 1.5 0.15 0 0 0</pose><geometry><box><size>0.04 0.6 0.30</size></box></geometry></collision>
        <visual name="j_w_visual"><pose>1.8 1.5 0.15 0 0 0</pose><geometry><box><size>0.04 0.6 0.30</size></box></geometry><material><ambient>0.75 0.77 0.80 1</ambient><diffuse>0.75 0.77 0.80 1</diffuse></material></visual>
        <collision name="j_s_collision"><pose>2.1 1.2 0.15 0 0 0</pose><geometry><box><size>0.6 0.04 0.30</size></box></geometry></collision>
        <visual name="j_s_visual"><pose>2.1 1.2 0.15 0 0 0</pose><geometry><box><size>0.6 0.04 0.30</size></box></geometry><material><ambient>0.75 0.77 0.80 1</ambient><diffuse>0.75 0.77 0.80 1</diffuse></material></visual>
        <collision name="jk_collision"><pose>2.4 1.5 0.15 0 0 0</pose><geometry><box><size>0.04 0.6 0.30</size></box></geometry></collision>
        <visual name="jk_visual"><pose>2.4 1.5 0.15 0 0 0</pose><geometry><box><size>0.04 0.6 0.30</size></box></geometry><material><ambient>0.75 0.77 0.80 1</ambient><diffuse>0.75 0.77 0.80 1</diffuse></material></visual>
        <collision name="k_n_collision"><pose>2.7 1.8 0.15 0 0 0</pose><geometry><box><size>0.6 0.04 0.30</size></box></geometry></collision>
        <visual name="k_n_visual"><pose>2.7 1.8 0.15 0 0 0</pose><geometry><box><size>0.6 0.04 0.30</size></box></geometry><material><ambient>0.75 0.77 0.80 1</ambient><diffuse>0.75 0.77 0.80 1</diffuse></material></visual>
        <collision name="k_e_collision"><pose>3.0 1.5 0.15 0 0 0</pose><geometry><box><size>0.04 0.6 0.30</size></box></geometry></collision>
        <visual name="k_e_visual"><pose>3.0 1.5 0.15 0 0 0</pose><geometry><box><size>0.04 0.6 0.30</size></box></geometry><material><ambient>0.75 0.77 0.80 1</ambient><diffuse>0.75 0.77 0.80 1</diffuse></material></visual>
        <collision name="pq_s_collision"><pose>2.4 0.6 0.15 0 0 0</pose><geometry><box><size>1.2 0.04 0.30</size></box></geometry></collision>
        <visual name="pq_s_visual"><pose>2.4 0.6 0.15 0 0 0</pose><geometry><box><size>1.2 0.04 0.30</size></box></geometry><material><ambient>0.75 0.77 0.80 1</ambient><diffuse>0.75 0.77 0.80 1</diffuse></material></visual>
      </link>
    </model>
  </world>
</sdf>
